# Токен Telegram бота (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Секретный ключ интеграции Notion (получить на https://www.notion.so/my-integrations)
# Начинается обычно с secret_...
NOTION_TOKEN=secret_your_notion_api_token_here

# ID базы данных или страницы Notion
# Можно указать ID (2d1bc62a-0c70-8158-9955-000398a16908) или полную ссылку на базу
NOTION_DATABASE_ID=2d1bc62a-0c70-8158-9955-000398a16908

# Интервал проверки новых задач в Notion (в секундах)
POLL_INTERVAL_SECONDS=60

# Telegram ID администраторов через запятую (для управления и диагностики)
ADMIN_IDS=
